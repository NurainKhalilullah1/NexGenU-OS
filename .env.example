# NexGenU Workforce Dashboard — Environment Variables Template
# Copy this file to .env.local and populate the values.
# NEVER commit .env.local to version control.

# Supabase Public Configuration (accessible in browser)
NEXT_PUBLIC_SUPABASE_URL='your supabase project url'
NEXT_PUBLIC_SUPABASE_ANON_KEY='your supabase anon key'

# Supabase Server-Only Configuration (CRITICAL: never expose to client / NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY='your supabase service role key'

# Application URL
NEXT_PUBLIC_APP_URL=https://nexgenu-os.vercel.app

# Google SMTP Integration (Phase 2)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexGenU Workforce" <info.nexgenu01@gmail.com>

# Daily Digest Cron Secret (Phase 2)
CRON_SECRET=

